<?xml version="1.0" encoding="UTF-8"?>
<!-- MiniMax scene files (.mmax): RON text that starts with `format: "MiniMax"`. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-minimax-scene">
    <comment>MiniMax scene</comment>
    <sub-class-of type="text/plain"/>
    <icon name="application-x-minimax-scene"/>
    <glob pattern="*.mmax"/>
    <magic priority="60">
      <match type="string" value="format: &quot;MiniMax&quot;" offset="0:64"/>
    </magic>
  </mime-type>
</mime-info>
