[Desktop Entry]
Type=Application
Name=MiniMax
GenericName=3D Modeler
Comment=3ds Max-style polygon modeler, painter and renderer
Exec=minimax %f
Icon=minimax
Terminal=false
Categories=Graphics;3DGraphics;
Keywords=3D;modeling;modelling;mesh;polygon;render;
MimeType=application/x-minimax-scene;model/obj;model/gltf+json;model/gltf-binary;
StartupNotify=true
StartupWMClass=minimax
