# Maintainer: Holly-3D <local build>
#
# Local pacman package for Ilex 3D (formerly MiniMax), built from this git checkout.
#   cd packaging && makepkg -si          # build and install once
#   ./publish-repo.sh                    # build into the local [minimax] repo (name kept so pacman.conf still works)
#
# The source is a clone of the repository this PKGBUILD lives in
# (override with ILEX_SRC=/path/to/Holly-3D; MINIMAX_SRC still works), so only COMMITTED changes on
# the checked-out branch are built. Every new commit raises the version
# (0.<commit count>.g<short hash>), so `pacman -Syu` picks it up.
#
# CPU: tuned for Zen 3 (Ryzen 5000). On another CPU build with
#   ILEX_TARGET_CPU=native makepkg -sf   (MINIMAX_TARGET_CPU still works)

pkgname=ilex
pkgver=0.0.g0000000
pkgrel=1
pkgdesc='Clean 3ds Max-style polygon modeler, painter and renderer'
arch=('x86_64')
url='https://github.com/hollywoodenspoon/Holly-3D'
license=('LicenseRef-custom')
# Upgrades an installed MiniMax package in place; /usr/bin/minimax stays as a symlink.
provides=('minimax')
conflicts=('minimax')
replaces=('minimax')
# Bevy / wgpu / winit load X11 and Vulkan at run time (dlopen).
depends=(
  'gcc-libs' 'glibc' 'hicolor-icon-theme'
  'libx11' 'libxcursor' 'libxi' 'libxkbcommon-x11' 'libxrandr'
  'vulkan-icd-loader' 'vulkan-driver'
  'xdg-desktop-portal'
)
makedepends=('cargo' 'git')
optdepends=('blender: Cycles renderer bridge in Render Setup (F10)')
# !debug: Bevy debug info needs many GB of RAM and disk; !lto: cargo's own thin LTO is used.
options=('!debug' '!lto')
_src="${ILEX_SRC:-${MINIMAX_SRC:-$(cd "$startdir/.." && pwd)}}"
_cpu="${ILEX_TARGET_CPU:-${MINIMAX_TARGET_CPU:-znver3}}"
source=("$pkgname::git+file://$_src"
        'ilex.desktop'
        'ilex.svg'
        'ilex.xml')
sha256sums=('SKIP'
            '017efa7d960260caf360547b4aaf501dbc38d1e991af8680dba0c7fd1e60472d'
            'ed600723044f3856d25ffbd6c074acc2fb42319c591f268f4236d14252b15db7'
            '73834c1b07655501f3ab1dfddb8ad12f1ad5c4623812d342e238ddb03c702034')

pkgver() {
  cd "$pkgname"
  printf '0.%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # makepkg.conf's RUSTFLAGS replace .cargo/config.toml's rustflags, so the
  # CPU target is set here; a later -C target-cpu wins over an earlier one.
  export RUSTFLAGS="${RUSTFLAGS:-} -C target-cpu=$_cpu"
  cargo build --release --locked
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export RUSTFLAGS="${RUSTFLAGS:-} -C target-cpu=$_cpu"
  cargo test --release --locked --lib
}

package() {
  install -Dm755 "$pkgname/target/release/ilex" "$pkgdir/usr/bin/ilex"
  # Old scripts and muscle memory: `minimax scene.mmax` keeps working.
  ln -s ilex "$pkgdir/usr/bin/minimax"
  install -Dm644 ilex.desktop "$pkgdir/usr/share/applications/ilex.desktop"
  install -Dm644 ilex.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/ilex.svg"
  # The same icon for .ilex / .mmax / .ilexpose files in Dolphin / Nautilus.
  install -Dm644 ilex.svg "$pkgdir/usr/share/icons/hicolor/scalable/mimetypes/application-x-ilex-scene.svg"
  install -Dm644 ilex.xml "$pkgdir/usr/share/mime/packages/ilex.xml"
  install -Dm644 "$pkgname/README.md" "$pkgdir/usr/share/doc/ilex/README.md"
}
